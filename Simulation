        }
    
    def scan_vertebrae(self, vertebrae_id, num_cells=10):
        """Complete scan of C vertebrae containing A and B vapor cells with cathode vibration analysis"""
        vertebrae_data = []
        
        # Get vertebrae cathode vibration pattern
        vibration_data = self.simulate_vertebrae_cathode_vibration(vertebrae_id)
        
        print(f"=== Scanning Vertebrae {vertebrae_id} ===")
        print(f"Cathode frequency: {vibration_data['frequency']:.2f} Hz")
        print(f"Adrenal coupling: {vibration_data['adrenal_coupled']} ({vibration_data['gland_side']} gland)")
        print(f"Average cathode voltage: {np.mean(vibration_data['cathode_voltage']):.1f}V")
        print()
        
        for cell_idx in range(num_cells):
            cell_type = 'A' if random.random() < 0.6 else 'B'  # 60% A cells, 40% B cells
            
            # Initial cell position
            cell_position = (random.uniform(-5, 5), random.uniform(-5, 5), random.uniform(-2, 2))
            
            # Calculate cell movement due to vibration
            cell_trajectory = self.calculate_cell_shift_dynamics(vibration_data, cell_position)
            
            # Measure all 54 faces for this cell with vibration influence
            cell_data = []
            current_vibration = vibration_data['vibration_amplitude'][cell_idx % len(vibration_data['vibration_amplitude'])]
            
            for face in range(self.faces_per_molecule):
                face_measurement = self.measure_vapor_cell(cell_type, vertebrae_id, face, current_vibration)
                cell_data.append(face_measurement)
            
            vertebrae_data.append({
                'cell_type': cell_type,
                'cell_id': cell_idx,
                'face_measurements': cell_data,
                'initial_position': cell_position,
                'cell_trajectory': cell_trajectory,
                'vibration_response': cell_trajectory['mobility_index'],
                'cathode_coupling_strength': cell_trajectory['cathode_influence']
            })
        
        return vertebrae_data, vibration_data
    
    def analyze_composition(self, vertebrae_data):
        """Analyze the H2O3/Gas/Electric composition from measurements"""
        h2o3_signals = []
        gas_signals = []
        electric_signals = []
        
        for cell in vertebrae_data:
            for face_data in cell['face_measurements']:
                h2o3_signals.extend(face_data['measurements']['A3'])
                gas_signals.extend(face_data['measurements']['B3'])
                electric_signals.extend(face_data['measurements']['C3'])
        
        return {
            'h2o3_mean': np.mean(h2o3_signals),
            'h2o3_std': np.std(h2o3_signals),
            'gas_mean': np.mean(gas_signals),
            'gas_std': np.std(gas_signals),
            'electric_mean': np.mean(electric_signals),
            'electric_std': np.std(electric_signals),
            'total_measurements': len(h2o3_signals)
        }
    
    def visualize_3d_measurements(self, vertebrae_data):
        """Create 3D visualization of vapor cell measurements"""
        fig = plt.figure(figsize=(15, 5))
        
        # Plot 1: H2O3 (A3 sensor) measurements
        ax1 = fig.add_subplot(131, projection='3d')
        x, y, z = [], [], []
        colors = []
        
        for cell in vertebrae_data[:3]:  # First 3 cells for visualization
            for face_idx, face_data in enumerate(cell['face_measurements'][:18]):  # First 18 faces
                face_x = face_idx % 6
                face_y = face_idx // 6
                face_z = np.mean(face_data['measurements']['A3'])
                
                x.append(face_x)
                y.append(face_y)
                z.append(face_z)
                colors.append('red' if cell['cell_type'] == 'A' else 'blue')
        
        ax1.scatter(x, y, z, c=colors, alpha=0.6)
        ax1.set_title('H2O3 Detection (A3 Sensor)')
        ax1.set_xlabel('X Face')
        ax1.set_ylabel('Y Face')
        ax1.set_zlabel('Signal Strength')
        
        # Plot 2: Gas Phase (B3 sensor) measurements
        ax2 = fig.add_subplot(132, projection='3d')
        z_gas = []
        for cell in vertebrae_data[:3]:
            for face_idx, face_data in enumerate(cell['face_measurements'][:18]):
                z_gas.append(np.mean(face_data['measurements']['B3']))
        
        ax2.scatter(x, y, z_gas, c=colors, alpha=0.6)
        ax2.set_title('Gas Phase (B3 Sensor)')
        ax2.set_xlabel('X Face')
        ax2.set_ylabel('Y Face')
        ax2.set_zlabel('Signal Strength')
        
        # Plot 3: Electric Charge (C3 sensor) measurements
        ax3 = fig.add_subplot(133, projection='3d')
        z_electric = []
        for cell in vertebrae_data[:3]:
            for face_idx, face_data in enumerate(cell['face_measurements'][:18]):
                z_electric.append(np.mean(face_data['measurements']['C3']))
        
        ax3.scatter(x, y, z_electric, c=colors, alpha=0.6)
        ax3.set_title('Electric Charge (C3 Sensor)')
        ax3.set_xlabel('X Face')
        ax3.set_ylabel('Y Face')
        ax3.set_zlabel('Signal Strength')
        
        plt.tight_layout()
        plt.show()
    
